# Copy to ~/.agent.env (chmod 600). Never commit the real file.
TELEGRAM_CHAT_ID=123456789        # your own Telegram user/chat id (only you can talk to the bot)
AGENT_MODEL=                      # optional: opus | sonnet | haiku | full model id
IDLE_RESTART_MIN=120              # fresh session after this many idle minutes
AGENT_LOGIN_HELPER=1              # 1 = run the phone login helper (needs Tailscale)
AGENT_DEBUG=0                     # 1 = Claude Code debug log in logs/
# Voice notes: put GROQ_API_KEY=... in ~/.local/state/personal-agent/secrets/groq.env (chmod 600)
