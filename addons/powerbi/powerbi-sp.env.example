# Copy to ~/.local/state/personal-agent/secrets/powerbi-sp.env (chmod 600). Never commit the real file.
PBI_TENANT_ID=00000000-0000-0000-0000-000000000000
PBI_CLIENT_ID=00000000-0000-0000-0000-000000000000
PBI_CLIENT_SECRET=your-service-principal-secret
# Default model for pbi_dax.py (workspace id + semantic model id)
PBI_GROUP_ID=00000000-0000-0000-0000-000000000000
PBI_DATASET_ID=00000000-0000-0000-0000-000000000000
# The ONLY workspace publish-report.py may write to
PBI_DRAFTS_WORKSPACE=Agent Drafts
